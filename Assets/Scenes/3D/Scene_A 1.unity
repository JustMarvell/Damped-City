  m_Script: {fileID: 11500000, guid: 380dac98115ca4198a547173d253e0cf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    name: Wilson
    isEndGameDialogue: 0
    endGameTriggerTime: 5
    isFinalGameDialogue: 0
    finalGameTriggerTime: 5
    canDeleteObstacle: 1
    ObstaclesToDelete:
    - {fileID: 1307114367}
    - {fileID: 2094564929}
    - {fileID: 1333471101}
    canActivateObject: 1
    objectToActivate:
    - {fileID: 866201388}
    - {fileID: 31971078}
    - {fileID: 1090210617}
    haveNextDialogue: 0
    nextDialogue: {fileID: 0}
    nextDialogueCooldown: 5
    sentences:
    - speaker: Wilson
      lookTarget: {fileID: 458250823}
      sentences: 'The curse feeds on those mushroom. Scattered in the main flooded
        halls ahead. '
    - speaker: Wilson
      lookTarget: {fileID: 0}
      sentences: "Plant\u2019s like mushroom, glowing, clouded in those ominous aura.
        Collect them all, bring them back to me."
    - speaker: Wilson
      lookTarget: {fileID: 0}
      sentences: "With them, I can finally finish what I\u2019ve started... "
    - speaker: Wilson
      lookTarget: {fileID: 0}
      sentences: 'and maybe.....

        get us both out alive.'
    - speaker: Player
      lookTarget: {fileID: 0}
      sentences: ' But beware, the monsters patrol randomly, drawn anything that
        enter their sight. '
    - speaker: Wilson
      lookTarget: {fileID: 0}
      sentences: Stay in the shadows, or it'll be over quick.
    - speaker: Wilson
      lookTarget: {fileID: 0}
      sentences: "Hurry... \nthe waters are rising. And they're always watching."
